HOST=127.0.0.1
PORT=6174
CODEX_APP_SERVER_PORT=43117
# Set to 1 if you want Codex app-server APIs to start automatically.
CODEX_APP_SERVER_AUTOSTART=0
CLI_WEB_DEFAULT_CWD=/home/you

# Optional: require this token on HTTP/API/WebSocket requests when exposing beyond a private VPN.
# AGENT_TMUX_WEB_AUTH_TOKEN=change-me

# Optional: customize the agent CLI launcher list shown in the tmux menu.
# This replaces the built-in catalog. Grouped modes are exclusive; ungrouped modes are checkboxes.
# CLI_WEB_TOOLS=[{"id":"claude","label":"Claude Code","command":"claude","defaultSessionName":"claude","modes":[{"id":"default","label":"Default","args":"","defaultEnabled":true,"exclusiveGroup":"permissions"},{"id":"yolo","label":"Yolo","args":"--dangerously-skip-permissions","exclusiveGroup":"permissions","dangerous":true}]}]

# Optional: attachment limits and expiry.
# AGENT_TMUX_WEB_JSON_LIMIT=25mb
# AGENT_TMUX_WEB_UPLOAD_MAX_BYTES=52428800
# AGENT_TMUX_WEB_UPLOAD_TTL_MS=86400000
